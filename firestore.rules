rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // shared levels: anyone can read a level by its short code; only its author can create it
    match /levels/{code} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    // each player's own levels and progress
    match /users/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // leaderboard: everyone can read it; a signed-in player can only write their own row, with sane numbers
    match /leaderboard/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;   // "Delete account" in the app
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= 3000
        && request.resource.data.levels is int && request.resource.data.levels <= 1000
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 50000000
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
    }
    // daily challenges: everyone reads; only you write them, from the Firebase console (or the push script with an admin key)
    match /daily/{date} {
      allow read: if true;
      allow write: if false;
    }
    // Today and This week leaderboards: one row per signed-in player per day / per week
    match /lb_day/{day}/scores/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;   // "Delete account" in the app
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 300000
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
    }
    match /lb_week/{week}/scores/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;   // "Delete account" in the app
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 1500000
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
    }
    // extra levels 101-1000 published online: everyone reads; only you write them (console or tools/levels/push_pack.js)
    match /level_packs/{pack} {
      allow read: if true;
      allow write: if false;
    }
    // anonymous player stats, one row per install (no names, no account ids); readable so the Studio Stats screen can count them
    match /players/{id} {
      allow read: if true;
      allow create, update: if id.size() >= 10 && id.size() <= 40
        && request.resource.data.keys().hasOnly(['maxLevel', 'done', 'dailies', 'streak', 'pts', 'dailyOpen', 'platform', 'ver', 'first', 'last', 'levels'])
        && request.resource.data.maxLevel is int && request.resource.data.maxLevel >= 0 && request.resource.data.maxLevel <= 1000
        && request.resource.data.done is int && request.resource.data.done <= 1000
        && request.resource.data.last is int
        && request.resource.data.platform is string && request.resource.data.platform.size() <= 10;
      allow delete: if false;
    }
  }
}
