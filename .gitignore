# npm packages: install with `npm install`. Only the native iOS parts of the Capacitor plugins are committed,
# so Xcode can resolve its Swift packages straight after cloning (Package.swift points into node_modules).
/node_modules/*
!/node_modules/@capgo/
!/node_modules/@capacitor-community/
!/node_modules/@capacitor/
/node_modules/@capacitor/*
!/node_modules/@capacitor/app/
!/node_modules/@capacitor/haptics/
!/node_modules/@capacitor/ios/
/node_modules/@capacitor/app/*
!/node_modules/@capacitor/app/package.json
!/node_modules/@capacitor/app/ios/
!/node_modules/@capacitor/app/Package.swift
/node_modules/@capacitor/haptics/*
!/node_modules/@capacitor/haptics/package.json
!/node_modules/@capacitor/haptics/ios/
!/node_modules/@capacitor/haptics/Package.swift
/node_modules/@capgo/*
!/node_modules/@capgo/capacitor-social-login/
!/node_modules/@capgo/native-purchases/
/node_modules/@capgo/capacitor-social-login/*
!/node_modules/@capgo/capacitor-social-login/ios/
!/node_modules/@capgo/capacitor-social-login/Package.swift
!/node_modules/@capgo/capacitor-social-login/package.json
!/node_modules/@capgo/capacitor-social-login/CapgoCapacitorSocialLogin.podspec
/node_modules/@capgo/native-purchases/*
!/node_modules/@capgo/native-purchases/ios/
!/node_modules/@capgo/native-purchases/Package.swift
!/node_modules/@capgo/native-purchases/package.json
!/node_modules/@capgo/native-purchases/CapgoNativePurchases.podspec
/node_modules/@capacitor-community/*
!/node_modules/@capacitor-community/admob/
/node_modules/@capacitor-community/admob/*
!/node_modules/@capacitor-community/admob/ios/
!/node_modules/@capacitor-community/admob/Package.swift
!/node_modules/@capacitor-community/admob/package.json
!/node_modules/@capacitor-community/admob/CapacitorCommunityAdmob.podspec
build/
.DS_Store
*.xcuserstate
xcuserdata/
game-src/voltworks*.html
game-src/tests/shots/
